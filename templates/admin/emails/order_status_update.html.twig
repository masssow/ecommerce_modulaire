{# Variables: order, status, subject #}
<!doctype html>
<html lang="fr">
  <body style="font-family: Arial, sans-serif; color:#111; line-height:1.5;">
    <div style="max-width:640px;margin:0 auto;">
      <h2 style="margin-bottom:8px;">{{ subject }}</h2>

      {% if status == 'paid' %}
        <p>Bonjour,</p>
        <p>Nous confirmons la réception de votre paiement pour la commande <strong>{{ order.number ?? order.id }}</strong>.</p>
        <p>Nous allons préparer votre commande dans les plus brefs délais.</p>
      {% elseif status == 'preparing' %}
        <p>Bonjour,</p>
        <p>Votre commande <strong>{{ order.number ?? order.id }}</strong> est <strong>en cours de préparation</strong>.</p>
      {% elseif status == 'shipped' %}
        <p>Bonjour,</p>
        <p>Bonne nouvelle ! Votre commande <strong>{{ order.number ?? order.id }}</strong> a été <strong>expédiée</strong>.</p>
        {% if order.trackingNumber is defined and order.trackingNumber %}
          <p>Numéro de suivi : <strong>{{ order.trackingNumber }}</strong></p>
        {% endif %}
      {% else %}
        <p>Bonjour,</p>
        <p>Statut de votre commande <strong>{{ order.number ?? order.id }}</strong> : {{ status }}.</p>
      {% endif %}

      <hr style="border:none;border-top:1px solid #eee;margin:16px 0;">
      <p style="font-size:12px;color:#666;">Merci pour votre commande.</p>
    </div>
  </body>
</html>
