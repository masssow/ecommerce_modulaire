{# templates/security/register.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Créer un compte{% endblock %}

{% block body %}
<!-- Register Start -->
<div class="container-xxl py-5">
  <div class="container">
    <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
      <h1 class="mb-3">Créer un compte</h1>
      <p>Inscrivez-vous pour suivre vos commandes, accélérer vos paiements et gérer vos adresses.</p>
    </div>

    <div class="row g-4">
      <!-- Formulaire centré -->
      <div class="col-lg-6 col-md-8 col-12 mx-auto">
        <div class="wow fadeInUp" data-wow-delay="0.2s">

          {{ form_start(registrationForm) }}

          {# erreurs globales #}
          {% if not registrationForm.vars.valid %}
            <div class="alert alert-warning mb-4">
              {{ form_errors(registrationForm) }}
            </div>
          {% endif %}

          <div class="row g-3">

            {# Prénom #}
            <div class="col-md-6">
              <div class="form-floating">
                {{ form_widget(registrationForm.firstName, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.firstName, 'Prénom') }}
                {{ form_errors(registrationForm.firstName) }}
              </div>
            </div>

            {# Nom #}
            <div class="col-md-6">
              <div class="form-floating">
                {{ form_widget(registrationForm.lastName, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.lastName, 'Nom') }}
                {{ form_errors(registrationForm.lastName) }}
              </div>
            </div>

            {# Email #}
            <div class="col-12">
              <div class="form-floating">
                {{ form_widget(registrationForm.email, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.email, 'Adresse e-mail') }}
                {{ form_errors(registrationForm.email) }}
              </div>
            </div>

            {# MDP #}
            <div class="col-md-6">
              <div class="form-floating">
                {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.plainPassword.first, 'Mot de passe') }}
                {{ form_errors(registrationForm.plainPassword.first) }}
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating">
                {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.plainPassword.second, 'Confirmez le mot de passe') }}
                {{ form_errors(registrationForm.plainPassword.second) }}
              </div>
            </div>

            {# Adresse (champ unique) #}
            <div class="col-12">
              <div class="form-floating">
                {{ form_widget(registrationForm.addr_address, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.addr_address, 'Adresse') }}
                {{ form_errors(registrationForm.addr_address) }}
              </div>
            </div>

            {# CP / Ville / Pays #}
            <div class="col-md-4">
              <div class="form-floating">
                {{ form_widget(registrationForm.addr_postalCode, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.addr_postalCode, 'Code postal') }}
                {{ form_errors(registrationForm.addr_postalCode) }}
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-floating">
                {{ form_widget(registrationForm.addr_city, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.addr_city, 'Ville') }}
                {{ form_errors(registrationForm.addr_city) }}
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-floating">
                {{ form_widget(registrationForm.addr_country, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.addr_country, 'Pays') }}
                {{ form_errors(registrationForm.addr_country) }}
              </div>
            </div>

            {# Téléphone #}
            <div class="col-md-6">
              <div class="form-floating">
                {{ form_widget(registrationForm.addr_phone, {'attr': {'class':'form-control', 'placeholder':' '}}) }}
                {{ form_label(registrationForm.addr_phone, 'Téléphone') }}
                {{ form_errors(registrationForm.addr_phone) }}
              </div>
            </div>

            {# Rendre champs cachés (CSRF, honeypot) #}
            {{ form_rest(registrationForm) }}

            <div class="col-12">
              <button class="btn btn-primary w-100 py-3" type="submit">Créer mon compte</button>
              <div class="text-center mt-3">
                <a href="{{ path('app_login') }}" class="small">J’ai déjà un compte</a>
              </div>
            </div>

          </div>

          {{ form_end(registrationForm) }}
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Register End -->
{% endblock %}
