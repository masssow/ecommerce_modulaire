{# templates/reset_password/email.html.twig #}
{% extends 'emails/_base.html.twig' %}

{% block subject %}Réinitialisation de votre mot de passe — Lacrose{% endblock %}

{% block body %}
  <h2 style="margin:0 0 12px;font-size:20px;line-height:1.25;color:#111827;">
    Réinitialiser votre mot de passe
  </h2>

  <p style="margin:0 0 14px;">
    Bonjour, <br>
    Vous avez demandé à réinitialiser votre mot de passe sur <strong>Lacrose</strong>.
  </p>

  <p style="margin:0 0 18px;">
    Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe.
  </p>

  <p style="margin:0 0 22px;">
    <a href="{{ url('app_reset_password', {token: resetToken.token}) }}"
       style="display:inline-block;padding:12px 18px;background:#111;color:#fff;text-decoration:none;border-radius:8px;font-size:15px;font-weight:700;">
      Réinitialiser mon mot de passe
    </a>
  </p>

  <p style="margin:0 0 10px;font-size:14px;color:#374151;">
    Ce lien expire : {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
  </p>

  <p style="margin:16px 0 0;font-size:13px;color:#6b7280;">
    Si vous n’êtes pas à l’origine de cette demande, ignorez cet email.
  </p>
{% endblock %}
