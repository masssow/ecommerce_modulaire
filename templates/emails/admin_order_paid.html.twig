{% extends 'emails/_base.html.twig' %}

{% block body %}
  <h2>Nouvelle commande à préparer</h2>

  <p><strong>Commande #{{ orderId }}</strong></p>

  <p>
    <strong>Total :</strong>
    {{ ((total ?? 0) / 100) | number_format(2, ',', ' ') }} €
  </p>

  <p>
    <strong>Email client :</strong> {{ customerEmail ?? '—' }}
  </p>

  {% if order %}
    <p><strong>Statut :</strong> {{ order.status ?? 'paid' }}</p>
    <p><strong>Date :</strong> {{ order.createdAt is defined and order.createdAt ? order.createdAt|date('d/m/Y H:i') : '—' }}</p>
  {% endif %}

  <hr>

  <p>
    Action : préparer, emballer, expédier ✅
  </p>

  {# V2 : ajouter items, adresse livraison, tel, lien EasyAdmin #}
{% endblock %}
