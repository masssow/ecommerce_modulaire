{# templates/emails/order_status_update.html.twig #}
{% set locale = app.request is defined ? app.request.locale : 'fr' %}
{% set currency = 'EUR' %}

<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8" />
    <title>{{ subject ?? 'Mise à jour de votre commande' }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body { font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin:0; padding:0; background:#f3f4f6; }
      .wrap { max-width: 620px; margin: 0 auto; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.05);}
      .header { background:#0e7490; color:#fff; padding:20px 24px; }
      .content { padding:24px; color:#111827; }
      .muted { color:#6b7280; font-size:13px; }
      .footer { color:#6b7280; font-size:12px; padding:16px 24px 24px; }
      .table { width:100%; border-collapse:collapse; margin-top:16px; }
      .table th, .table td { padding:8px 0; border-bottom:1px solid #e5e7eb; text-align:left; font-size:14px; }
      .badge { display:inline-block; padding:4px 8px; border-radius:999px; background:#e5f3ff; color:#1d4ed8; font-size:12px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="header">
        <h2 style="margin:0;">
          {% if subject is defined %}
            {{ subject }}
          {% else %}
            Mise à jour de votre commande
          {% endif %}
        </h2>
      </div>

      <div class="content">
        {# on suppose que Order a getCustomer()->getUser()->getFirstname() éventuellement #}
        <p>
          Bonjour
          {% if order.customer is defined and order.customer.user is defined and order.customer.user.firstname is not null %}
            {{ order.customer.user.firstname }},
          {% else %}
            cher client,
          {% endif %}
        </p>

        <p>
          Le statut de votre commande
          <strong>#{{ order.number ?? order.id }}</strong>
          a été mis à jour :
          <span class="badge">
            {{ status|trans }}
          </span>
        </p>

        {% if order.createdAt is defined %}
          <p class="muted">
            Passée le {{ order.createdAt|date('d/m/Y à H:i') }}.
          </p>
        {% endif %}

        {# Total si disponible en centimes #}
        {% if order.total is defined %}
          {% set total_eur = order.total / 100 %}
          <p>
            <strong>Total :</strong>
            {{ total_eur|number_format(2, ',', ' ') }} {{ currency }}
          </p>
        {% endif %}

        {# Si tu as une collection d’items: order.items, on affiche un récap simple #}
        {% if order.items is defined and order.items|length > 0 %}
          <h3>Détails de la commande</h3>
          <table class="table" role="presentation" aria-hidden="true">
            <thead>
              <tr>
                <th>Produit</th>
                <th>Qté</th>
                <th>Prix</th>
              </tr>
            </thead>
            <tbody>
              {% for item in order.items %}
                {% set unit = (item.unitPrice is defined ? item.unitPrice : (item.price ?? 0)) / 100 %}
                <tr>
                  <td>{{ item.productName ?? item.name }}</td>
                  <td>{{ item.quantity ?? 1 }}</td>
                  <td>{{ unit|number_format(2, ',', ' ') }} {{ currency }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        <p style="margin-top:24px;">
          Vous pouvez consulter le détail de votre commande en vous connectant à votre espace client.
        </p>

        <p class="muted" style="margin-top:16px;">
          Si vous n’êtes pas à l’origine de cette commande, merci de nous contacter immédiatement.
        </p>
      </div>

      <div class="footer">
        Boutique Sandbox · sandbox.massgrafik.com
      </div>
    </div>
  </body>
</html>
