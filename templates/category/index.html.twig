{# templates/category/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
<div class="container">
  <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
    <a href="{{ path('app_home') }}" class="stext-109 cl8 hov-cl1 trans-04">
      Accueil
      <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
    </a>
    <span class="stext-109 cl4">Catégories</span>
  </div>
</div>

<section class="sec-banner bg0 p-t-80 p-b-50">
  <div class="container">
    <h3 class="ltext-103 cl5 p-b-20">Toutes les catégories</h3>

    <div class="row">
      {% for category in categories %}
        {% set img = category.imageName
          ? asset('uploads/category/' ~ category.imageName)
          : asset('images/placeholder-image.png')
        %}
        <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
          <div class="block1 wrap-pic-w">
            <img src="{{ img }}" alt="{{ category.name }}" loading="lazy">
            <a href="{{ path('category_show', { id: category.id }) }}"
               class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
              <div class="block1-txt-child1 flex-col-l">
                <span class="block1-name ltext-102 trans-04 p-b-8">{{ category.name }}</span>
                <span class="block1-info stext-102 trans-04">Voir les produits</span>
              </div>
              <div class="block1-txt-child2 p-b-4 trans-05">
                <div class="block1-link stext-101 cl0 trans-09">Voir</div>
              </div>
            </a>
          </div>
        </div>
      {% else %}
        <div class="col-12">
          <p class="stext-111 cl6">Aucune catégorie disponible.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
