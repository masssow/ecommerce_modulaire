{# templates/partials/_cookie_banner.html.twig #}
<div
  id="cookie-banner"
  class="cookie-banner bg0 bor12"
  style="
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    box-shadow: 0 -6px 24px rgba(0,0,0,.12);
  "
>
  <div class="container">
    <div class="row align-items-center p-t-12 p-b-12">

      {# Texte #}
      <div class="col-12 col-md-8 p-b-10 p-b-0-md">
        <p class="stext-101 cl6 m-b-6 cookie-title">
          Cookies & confidentialité
        </p>

        <p class="stext-102 cl6 m-b-0 cookie-text">
          Nous utilisons des cookies strictement nécessaires et, avec votre accord,
          des cookies de mesure d’audience pour améliorer la boutique.
          <a href="{{ path('app_cookies_policy') }}" class="cl1 hov-cl1 cookie-link">
            En savoir plus
          </a>
        </p>
      </div>

      {# Boutons #}
      <div class="col-12 col-md-4">
        <div class="cookie-actions d-flex flex-wrap justify-content-start justify-content-md-end">

          <button
            type="button"
            class="cookie-btn cookie-btn-secondary"
            data-cookie-choice="necessary"
          >
            Nécessaires
          </button>

          <button
            type="button"
            class="cookie-btn cookie-btn-primary"
            data-cookie-choice="all"
          >
            J’accepte
          </button>

        </div>
      </div>

    </div>
  </div>
</div>
