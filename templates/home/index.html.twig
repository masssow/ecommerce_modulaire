{% extends 'base.html.twig' %}

{% block title %}Accueil - Boutique en ligne{% endblock %}

{% block body %}

{# =========================
   Slider (squelette dynamique)
   - Utilise le template .wrap-slick1/.slick1
   - Si "slides" est fourni par le contrôleur -> dynamique
   - Sinon -> 3 slides fallback
   ========================= #}
<section class="section-slide">
  <div class="wrap-slick1">
    <div class="slick1">

      {% if slides is defined and slides|length > 0 %}
        {% for slide in slides %}
          <div class="item-slick1" style="background-image: url({{ slide.imageUrl }});">
            <div class="container h-full">
              <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                <div class="layer-slick1 animated visible-false" data-appear="{{ slide.appearSmall|default('fadeInDown') }}" data-delay="{{ slide.delaySmall|default(0) }}">
                  <span class="ltext-101 cl2 respon2">{{ slide.titleSmall }}</span>
                </div>

                <div class="layer-slick1 animated visible-false" data-appear="{{ slide.appearBig|default('fadeInUp') }}" data-delay="{{ slide.delayBig|default(800) }}">
                  <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">{{ slide.titleBig }}</h2>
                </div>

                <div class="layer-slick1 animated visible-false" data-appear="{{ slide.appearCta|default('zoomIn') }}" data-delay="{{ slide.delayCta|default(1600) }}">
                  <a href="{{ slide.ctaHref|default('#') }}" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
                    {{ slide.ctaLabel|default('Shop Now') }}
                  </a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="item-slick1" style="background-image: url({{ asset('images/slide-01.jpg') }});">
          <div class="container h-full">
            <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
              <div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
                <span class="ltext-101 cl2 respon2">Women Collection 2018</span>
              </div>
              <div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
                <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">NEW SEASON</h2>
              </div>
              <div class="layer-slick1 animated visible-false" data-appear="zoomIn" data-delay="1600">
                <a href="#" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">Shop Now</a>
              </div>
            </div>
          </div>
        </div>

        <div class="item-slick1" style="background-image: url({{ asset('images/slide-02.jpg') }});">
          <div class="container h-full">
            <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
              <div class="layer-slick1 animated visible-false" data-appear="rollIn" data-delay="0">
                <span class="ltext-101 cl2 respon2">Men New-Season</span>
              </div>
              <div class="layer-slick1 animated visible-false" data-appear="lightSpeedIn" data-delay="800">
                <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">Jackets & Coats</h2>
              </div>
              <div class="layer-slick1 animated visible-false" data-appear="slideInUp" data-delay="1600">
                <a href="#" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">Shop Now</a>
              </div>
            </div>
          </div>
        </div>

        <div class="item-slick1" style="background-image: url({{ asset('images/slide-03.jpg') }});">
          <div class="container h-full">
            <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
              <div class="layer-slick1 animated visible-false" data-appear="rotateInDownLeft" data-delay="0">
                <span class="ltext-101 cl2 respon2">Men Collection 2018</span>
              </div>
              <div class="layer-slick1 animated visible-false" data-appear="rotateInUpRight" data-delay="800">
                <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">New arrivals</h2>
              </div>
              <div class="layer-slick1 animated visible-false" data-appear="rotateIn" data-delay="1600">
                <a href="#" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">Shop Now</a>
              </div>
            </div>
          </div>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{# =========================
   Bannières catégories (dynamique OK)
   - Corrigé: remise de l'<a> overlay clickable
   ========================= #}
<div class="sec-banner bg0 p-t-80 p-b-50">
  <div class="container">
    <div class="row">
      {% for category in categories %}
        <div class="col-md-6 col-xl-4 p-b-30 m-lr-auto">
          <div class="block1 wrap-pic-w">
            <img src="{{ asset('uploads/category/' ~ category.imageName) }}" alt="{{ category.name }}" loading="lazy">

            <a href="#"
               class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3">
			   {# TODO : Path dynamique #}
			    {# <a href="{{ path('boutique_category', { slug: category.slug }) }}"
               class="block1-txt ab-t-l s-full flex-col-l-sb p-lr-38 p-tb-34 trans-03 respon3"> #}
              <div class="block1-txt-child1 flex-col-l">
                <span class="block1-name ltext-102 trans-04 p-b-8">{{ category.name }}</span>
                <span class="block1-info stext-102 trans-04">Découvrez nos produits</span>
              </div>
              <div class="block1-txt-child2 p-b-4 trans-05">
                <div class="block1-link stext-101 cl0 trans-09">Shop Now</div>
              </div>
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{# =========================
   Produits + Filtres/Search (squelette prêt)
   ========================= #}
<section class="bg0 p-t-23 p-b-140">
  <div class="container">
    <div class="p-b-10">
      <h3 class="ltext-103 cl5">Faites vous plaisir</h3>
    </div>

    <div class="flex-w flex-sb-m p-b-52">
      {# Filtres (dynamiques : 5 sous-catégories max comme tu l'avais) #}
      <div class="flex-w flex-l-m filter-tope-group m-tb-10">
        <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 how-active1" data-filter="*">
          Tous les produits
        </button>

        {% set count = 0 %}
        {% for subCategory in subCategories %}
          {% if count < 5 %}
            <button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".{{ subCategory.slug }}">
              {{ subCategory.name }}
            </button>
            {% set count = count + 1 %}
          {% endif %}
        {% endfor %}

        <a href="#" class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5">
		{# TODO : Path Dynamique #}
		{# <a href="{{ path('categories_list') }}" class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5"> #}
          Voir toutes les catégories
        </a>
      </div>

      {# Boutons panneau Filtrer/Rechercher (squelette) #}
      <div class="flex-w flex-c-m m-tb-10">
        <div class="flex-c-m stext-106 cl6 size-104 bor4 pointer hov-btn3 trans-04 m-r-8 m-tb-4 js-show-filter">
          <i class="icon-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-filter-list"></i>
          <i class="icon-close-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
          Filtrer
        </div>

        <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 js-show-search">
          <i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-search"></i>
          <i class="icon-close-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
          Rechercher
        </div>
      </div>

      {# Search (squelette, sans logique) #}
      <div class="dis-none panel-search w-full p-t-10 p-b-15">
        <form class="bor8 dis-flex p-l-15" method="get" action="#">
          <button class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04" type="submit">
            <i class="zmdi zmdi-search"></i>
          </button>
          <input class="mtext-107 cl2 size-114 plh2 p-r-15"
                 type="text" name="q" placeholder="Rechercher un produit...">
        </form>
      </div>

      {# Filter (squelette statique à brancher côté contrôleur plus tard) #}
      <div class="dis-none panel-filter w-full p-t-10">
        <div class="wrap-filter flex-w bg6 w-full p-lr-40 p-t-27 p-lr-15-sm">

          <div class="filter-col1 p-r-15 p-b-27">
            <div class="mtext-102 cl2 p-b-15">Trier par</div>
            <ul>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">Par défaut</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">Popularité</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">Mieux notés</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04 filter-link-active">Nouveautés</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">Prix: croissant</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">Prix: décroissant</a></li>
            </ul>
          </div>

          <div class="filter-col2 p-r-15 p-b-27">
            <div class="mtext-102 cl2 p-b-15">Prix</div>
            <ul>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04 filter-link-active">Tous</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">0 € – 50 €</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">50 € – 100 €</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">100 € – 150 €</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">150 € – 200 €</a></li>
              <li class="p-b-6"><a href="#" class="filter-link stext-106 trans-04">200 €+</a></li>
            </ul>
          </div>

          <div class="filter-col3 p-r-15 p-b-27">
            <div class="mtext-102 cl2 p-b-15">Couleur</div>
            <ul>
              <li class="p-b-6"><span class="fs-15 lh-12 m-r-6" style="color:#222;"><i class="zmdi zmdi-circle"></i></span><a href="#" class="filter-link stext-106 trans-04">Noir</a></li>
              <li class="p-b-6"><span class="fs-15 lh-12 m-r-6" style="color:#4272d7;"><i class="zmdi zmdi-circle"></i></span><a href="#" class="filter-link stext-106 trans-04 filter-link-active">Bleu</a></li>
              <li class="p-b-6"><span class="fs-15 lh-12 m-r-6" style="color:#b3b3b3;"><i class="zmdi zmdi-circle"></i></span><a href="#" class="filter-link stext-106 trans-04">Gris</a></li>
              <li class="p-b-6"><span class="fs-15 lh-12 m-r-6" style="color:#00ad5f;"><i class="zmdi zmdi-circle"></i></span><a href="#" class="filter-link stext-106 trans-04">Vert</a></li>
              <li class="p-b-6"><span class="fs-15 lh-12 m-r-6" style="color:#fa4251;"><i class="zmdi zmdi-circle"></i></span><a href="#" class="filter-link stext-106 trans-04">Rouge</a></li>
              <li class="p-b-6"><span class="fs-15 lh-12 m-r-6" style="color:#aaa;"><i class="zmdi zmdi-circle-o"></i></span><a href="#" class="filter-link stext-106 trans-04">Blanc</a></li>
            </ul>
          </div>

          <div class="filter-col4 p-b-27">
            <div class="mtext-102 cl2 p-b-15">Tags</div>
            <div class="flex-w p-t-4 m-r--5">
              <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">Fashion</a>
              <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">Lifestyle</a>
              <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">Denim</a>
              <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">Streetstyle</a>
              <a href="#" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">Crafts</a>
            </div>
          </div>

        </div>
      </div>
    </div>

    {# Grille produits (DYNAMIQUE OK) — doit être dans .row.isotope-grid #}
    <div class="row isotope-grid">
      {% for variant in productVariants %}
        <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item {{ variant.product.subCategory.slug }}">
          <div class="block2">
            <div class="block2-pic hov-img0">
              <img
                src="{{ asset('uploads/productVariant/' ~ variant.imageName) }}"
                alt="{{ variant.product.name }}"
                loading="lazy"
                class="img-fluid">
                
                  <a href="{{ path('product_show', { id:variant.id }) }}"
                 class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                Voir le produit
                  </a>
            </div>

            <div class="block2-txt flex-w flex-t p-t-14">
              <div class="block2-txt-child1 flex-col-l">
                <a href="{{ path('product_show', { id: variant.product.id }) }}"
                   class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                  {{ variant.product.name }}
                </a>

                <span class="stext-105 cl3">
                  {{ ((variant.priceAmount ?? 0) / 100) }} €                </span>
                
                {# TODO format_currency à voir #}
                {# <span class="stext-105 cl3">
                  {{ ((variant.priceAmount ?? 0) / 100) | format_currency(variant.priceCurrency|default('EUR')) }}
                </span> #}
              </div>

              <div class="block2-txt-child2 flex-r p-t-3">
                <a href="#" class="btn-addwish-b2 dis-block pos-relative js-addwish-b2" aria-label="Ajouter aux favoris">
                  <img class="icon-heart1 dis-block trans-04" src="{{ asset('images/icons/icon-heart-01.png') }}" alt="ICON">
                  <img class="icon-heart2 dis-block trans-04 ab-t-l" src="{{ asset('images/icons/icon-heart-02.png') }}" alt="ICON">
                </a>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {# Load More (squelette) #}
    {# <div class="flex-c-m flex-w w-full p-t-45">
      <a href="#" class="flex-c-m stext-101 cl5 size-103 bg2 bor1 hov-btn1 p-lr-15 trans-04">
        Load More
      </a>
    </div> #}
  </div>
</section>
{% endblock %}
