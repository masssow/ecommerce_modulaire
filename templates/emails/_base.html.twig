{# templates/emails/_base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block subject %}Notification{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#f6f6f6;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f6f6;padding:20px 0;">
  <tr>
    <td align="center">

      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;">

        {# ================= HEADER ================= #}
        <tr>
          <td style="padding:18px 20px;text-align:center;background:#111;color:#fff;">
          {% set logoUrl = logoUrl|default(absolute_url(asset('images/logo_pie_de_mail_transparent180x50.png'))) %}
            {% if logoUrl %}
              <img
                src="{{ logoUrl }}"
                alt="{{ brandName|default('Lacrose') }}"
                width="140"
                style="display:block;margin:0 auto;border:0;outline:none;text-decoration:none;max-width:140px;height:auto;"
              >
            {% else %}
              <h1 style="margin:0;font-size:20px;letter-spacing:0.5px;">
                {{ brandName|default('Lacrose') }}
              </h1>
            {% endif %}

            {% if brandTagline is defined and brandTagline %}
              <div style="margin-top:6px;font-size:12px;opacity:0.9;">
                {{ brandTagline }}
              </div>
            {% endif %}
          </td>
        </tr>

        {# ================= PROMO / PUB (OPTIONNEL) ================= #}
        {# Active uniquement si "promo" est fourni dans le context #}
        {% set promo = promo|default(null) %}
        {% if promo %}
          <tr>
            <td style="padding:14px 20px;background:#fff7e6;border-bottom:1px solid #f0e2c6;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="font-size:14px;line-height:1.4;color:#333;">
                    {% if promo.title is defined and promo.title %}
                      <div style="font-weight:bold;margin-bottom:4px;">
                        {{ promo.title }}
                      </div>
                    {% endif %}

                    {% if promo.text is defined and promo.text %}
                      <div style="margin-bottom:10px;">
                        {{ promo.text }}
                      </div>
                    {% endif %}

                    {% if promo.ctaHref is defined and promo.ctaHref and promo.ctaLabel is defined and promo.ctaLabel %}
                      <a href="{{ promo.ctaHref }}"
                         style="display:inline-block;padding:10px 14px;background:#111;color:#fff;text-decoration:none;border-radius:6px;font-size:13px;">
                        {{ promo.ctaLabel }}
                      </a>
                    {% endif %}
                  </td>

                  {% if promo.imageUrl is defined and promo.imageUrl %}
                    <td width="120" align="right" style="padding-left:10px;">
                     <img
                        src="{{ absolute_url(asset('images/logo_pie_de_mail_transparent180x50.png')) }}"
                        alt="Lacrose"
                        width="180"
                        height="50"
                        style="display:block;border:0;outline:none;text-decoration:none;max-width:180px;height:auto;"
                      >
                    <div style="font-size:12px;color:#111827;font-weight:700;margin-top:6px;">
                      Lacrose — Boutique en ligne
                    </div>
                    </td>
                  {% endif %}
                </tr>
              </table>
            </td>
          </tr>
        {% endif %}

        {# ================= CONTENT ================= #}
        <tr>
          <td style="padding:24px 22px;color:#333;font-size:14px;line-height:1.6;">
            {% block body %}{% endblock %}
          </td>
        </tr>

        {# ================= FOOTER ================= #}
        <tr>
          <td style="padding:14px 18px;text-align:center;font-size:12px;color:#888;background:#fafafa;">
            © {{ "now"|date("Y") }} {{ brandName|default('Lacrose') }}<br>
            Ceci est un email automatique — merci de ne pas répondre.
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
