{# templates/support/seller_application.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Vendre sur Lacrose - Candidature{% endblock %}

{% block body %}
<section class="bg0 p-t-75 p-b-120">
  <div class="container">

    <div class="row p-b-48">
      <div class="col-12 col-md-8">
        <h1 class="mtext-111 cl2 p-b-12">Vendre sur Lacrose</h1>
        <p class="stext-113 cl6">
          Vous êtes créatrice, marque ou boutique ? Remplissez ce formulaire pour proposer vos produits sur Lacrose.
        </p>
      </div>
    </div>

    <div class="row">
      <div class="col-12 col-lg-8 p-b-30">
        <h2 class="mtext-111 cl2 p-b-16">Candidature vendeur</h2>

        <form method="post" action="{{ path('app_sell_on_lacrose') }}">
          {# type = SELLER_APPLICATION #}
          <input type="hidden" name="type" value="SELLER_APPLICATION">

          <div class="row">
            <div class="col-12 col-md-6 p-b-16">
              <label class="stext-102 cl3">Marque / Société *</label>
              <input type="text" name="subject" required
                     class="form-control stext-111 cl2 p-t-10 p-b-10 p-l-15 p-r-15"
                     placeholder="Nom de votre marque ou société">
            </div>

            <div class="col-12 col-md-6 p-b-16">
              <label class="stext-102 cl3">Email de contact *</label>
              <input type="email" name="email" required
                     class="form-control stext-111 cl2 p-t-10 p-b-10 p-l-15 p-r-15"
                     value="{{ app.user ? app.user.email : '' }}">
            </div>

            <div class="col-12 col-md-6 p-b-16">
              <label class="stext-102 cl3">Nom du contact</label>
              <input type="text" name="contact_name"
                     class="form-control stext-111 cl2 p-t-10 p-b-10 p-l-15 p-r-15"
                     placeholder="Ex : Madame Adja">
            </div>

            <div class="col-12 col-md-6 p-b-16">
              <label class="stext-102 cl3">Lien (site, Instagram, etc.)</label>
              <input type="text" name="link"
                     class="form-control stext-111 cl2 p-t-10 p-b-10 p-l-15 p-r-15"
                     placeholder="https://...">
            </div>

            <div class="col-12 p-b-16">
              <label class="stext-102 cl3">Type de produits</label>
              <input type="text" name="product_types"
                     class="form-control stext-111 cl2 p-t-10 p-b-10 p-l-15 p-r-15"
                     placeholder="Ex : bijoux, abayas, cosmétiques...">
            </div>

            <div class="col-12 p-b-24">
              <label class="stext-102 cl3">Message *</label>
              <textarea name="body" rows="5" required
                        class="form-control stext-111 cl2 p-t-10 p-b-10 p-l-15 p-r-15"
                        placeholder="Présentez votre marque, vos produits et votre manière de travailler..."></textarea>
            </div>
          </div>

          <button type="submit"
                  class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15">
            Envoyer ma candidature
          </button>
        </form>
      </div>
    </div>

  </div>
</section>
{% endblock %}
