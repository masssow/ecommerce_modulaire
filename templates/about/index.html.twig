{% extends 'base.html.twig' %}

{% block title %}Qui sommes-nous ? - Lacrose{% endblock %}

{% block body %}
<section class="bg0 p-t-75 p-b-120">
  <div class="container">
    <div class="row p-b-60">
      <div class="col-12 col-md-8">
        <h1 class="mtext-111 cl2 p-b-12">Qui sommes-nous ?</h1>
        <p class="stext-113 cl6">
          Lacrose, une boutique pensée pour sublimer le quotidien avec des produits de beauté, bien-être et couture africaine.
        </p>
      </div>
    </div>

    <div class="row p-b-60">
      <div class="col-md-7 col-lg-8">
        <div class="p-t-7 p-r-85 p-r-15-lg p-r-0-md">
          <h2 class="mtext-111 cl2 p-b-16">Notre histoire</h2>
          <p class="stext-113 cl6 p-b-26">
            [Texte sur la naissance de Lacrose, votre parcours, votre vision...]
          </p>
        </div>
      </div>

      <div class="col-11 col-md-5 col-lg-4 m-lr-auto">
        <div class="how-bor1">
          <div class="hov-img0">
            <img src="{{ asset('images/about-lacrose-01.jpg') }}" alt="Lacrose - Notre histoire">
          </div>
        </div>
      </div>
    </div>

    <div class="row p-b-60">
      <div class="col-12">
        <h2 class="mtext-111 cl2 p-b-24">Nos valeurs</h2>
      </div>

      <div class="col-sm-6 col-md-4 p-b-30">
        <h3 class="stext-301 cl2 p-b-8">Authenticité</h3>
        <p class="stext-113 cl6">
          Des produits sélectionnés avec soin, en privilégiant la qualité et l’histoire de chaque pièce.
        </p>
      </div>

      <div class="col-sm-6 col-md-4 p-b-30">
        <h3 class="stext-301 cl2 p-b-8">Respect</h3>
        <p class="stext-113 cl6">
          Une relation sincère avec nos clientes, nos partenaires et nos créateurs.
        </p>
      </div>

      <div class="col-sm-6 col-md-4 p-b-30">
        <h3 class="stext-301 cl2 p-b-8">Élégance accessible</h3>
        <p class="stext-113 cl6">
          Proposer de belles pièces, accessibles, tout en valorisant le travail artisanal.
        </p>
      </div>
    </div>

        <div class="row p-b-60">
      <div class="col-12 col-md-8">
        <h2 class="mtext-111 cl2 p-b-16">Notre marque&nbsp;: Madame Adja</h2>
        <p class="stext-113 cl6 p-b-16">
          Madame Adja est la marque signature de Lacrose, dédiée à la couture africaine, aux tenues élégantes et aux pièces uniques.
        </p>
        <p class="stext-113 cl6">
          [Texte sur le positionnement de la marque, l’identité, ce qui la différencie...]
        </p>
      </div>
    </div>


    <div class="row p-b-30">
      <div class="col-12">
        <h2 class="mtext-111 cl2 p-b-24">Découvrez nos produits</h2>
      </div>

      {# exemple : inclusion d’un partial existant pour le carousel #}
      {% include 'product/partials/_section_catalogue.html.twig' with {
        products: featuredProducts|default([]),
        productVariants: featuredProductVariants|default([]),
        favoritesIds: favoritesIds|default([])
      } %}
    </div>

    <div class="row">
      <div class="col-12 text-center p-t-20 py-5">
        <a href="{{ path('product_index') }}"
           class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15">
          Retour à la boutique
        </a>
      </div>
    </div>
  </div>
</section>
{% endblock %}

