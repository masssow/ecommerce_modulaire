{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}

<style>
  /* Mini tuiles sous-catégories */
  .subcat-tile { padding-bottom: 18px; }
  .subcat-tile .wrap-pic-w { border-radius: 14px; overflow: hidden; }
  .subcat-tile img { height: 150px; width: 100%; object-fit: cover; display:block; }
  .subcat-tile .block1-txt { padding: 16px 14px !important; }
  .subcat-tile .block1-name { font-size: 16px !important; line-height: 1.15; }
  .subcat-tile .block1-info { font-size: 12px !important; opacity: .9; }
  .subcat-tile .block1-link { font-size: 12px !important; }
</style>

<div class="container p-t-60 p-b-30">

  <div class="p-b-20">
    <h2 class="ltext-103 cl5">{{ category.name }}</h2>

    {% if category.description %}
      <p class="stext-113 cl6 p-t-10">{{ category.description }}</p>
    {% endif %}

    <div class="p-t-15">
      <a class="stext-101 cl0 bg1 bor1 hov-btn1 p-lr-15 p-tb-8 trans-04"
         href="{{ path('category_products', { id: category.id }) }}">
        Voir tous les produits
      </a>
    </div>
  </div>

  <div class="row">
    {% for sub in subCategories %}
      {% set subImg = sub.imageName ? asset('uploads/subCategory/' ~ sub.imageName) : asset('images/placeholder-image.png') %}

      <div class="col-6 col-md-4 col-xl-3 m-lr-auto subcat-tile">
        <div class="block1 wrap-pic-w">
          <img src="{{ subImg }}" alt="{{ sub.name }}" loading="lazy">

          {# TEMP : à remplacer par ta vraie route de listing produits par sous-catégorie #}
          <a href="{{ path('category_products', { id: category.id }) }}?sub={{ sub.id }}"
             class="block1-txt ab-t-l s-full flex-col-l-sb trans-03 respon3">

            <div class="block1-txt-child1 flex-col-l">
              <span class="block1-name ltext-102 trans-04 p-b-4">{{ sub.name }}</span>
              <span class="block1-info stext-102 trans-04">Découvrir</span>
            </div>

            <div class="block1-txt-child2 p-b-4 trans-05">
              <div class="block1-link stext-101 cl0 trans-09">Shop</div>
            </div>

          </a>
        </div>
      </div>

    {% else %}
      <div class="col-12">
        <p class="stext-113 cl6">Aucune sous-catégorie disponible.</p>
      </div>
    {% endfor %}
  </div>

</div>

{% endblock %}
