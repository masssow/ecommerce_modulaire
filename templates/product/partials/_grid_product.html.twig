<div class="row isotope-grid">
      {% set favIds = favoritesIds|default([]) %}
      {% for variant in productVariants %}
        {% set vImg = variant.imageName ? asset('uploads/productVariant/' ~ variant.imageName) : asset('images/placeholder-image.png') %}
        <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item {{ variant.product.subCategory.slug }}">
          <div class="block2">
            <div class="block2-pic hov-img0">
              <img
                src="{{ vImg }}"
                alt="{{ variant.product.name }}"
                loading="lazy"
                class="img-fluid">

              {# CTA visible (géré via SCSS pour enlever le hover) #}
              <a href="{{ path('product_show', { id: variant.product.id }) }}"
                 class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04"
                 data-force-visible="1">
                Voir le produit
              </a>
            </div>

            <div class="block2-txt flex-w flex-t p-t-14">
              <div class="block2-txt-child1 flex-col-l">
                <a href="{{ path('product_show', { id: variant.product.id }) }}"
                   class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                  {{ variant.product.name }}
                </a>
                <span class="stext-105 cl3">
                  {{ ((variant.priceAmount|default(0)) / 100)|number_format(2, '.', ' ') }} {{ variant.priceCurrency|default('€') }}
                </span>
              </div>

              {# <div class="block2-txt-child2 flex-r p-t-3">
                {% include 'account/favorite/partials/_button.html.twig' with {
                  variant: variant,
                  isActive: variant.id in favIds
                } %}
              </div> #}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
