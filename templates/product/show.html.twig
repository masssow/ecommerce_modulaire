{# templates/product/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
  {% set titleProduct =
    currentVariant is defined and currentVariant.product
      ? currentVariant.product.name
      : (product is defined and product.name ? product.name : 'Produit')
  %}
  {{ titleProduct }}
{% endblock %}

{% block body %}

{# ---------------- Normalisation des variables ---------------- #}
{% set currentVariant = currentVariant is defined ? currentVariant : null %}
{% set currentProduct =
  (currentVariant and currentVariant.product)
    ? currentVariant.product
    : (product is defined ? product : null)
%}
{% set currency =
  (currentVariant and currentVariant.priceCurrency is defined)
    ? currentVariant.priceCurrency
    : 'EUR'
%}

{# =================== Breadcrumb =================== #}
<div class="container">
  <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
    <a href="{{ path('app_home') }}" class="stext-109 cl8 hov-cl1 trans-04">
      Accueil <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
    </a>

    {% if currentProduct and currentProduct.subCategory %}
      {% set sub = currentProduct.subCategory %}
      {% set cat = sub.categorie is defined ? sub.categorie : null %}

      {% if cat %}
        <a href="{{ path('category_show', {'id': cat.id}) }}"
           class="stext-109 cl8 hov-cl1 trans-04">
          {{ cat.name }}
        </a>
        <span class="stext-109 cl4 m-l-6 m-r-6">/</span>
      {% endif %}

      <a href="{{ path('category_show', {'id': sub.id}) }}"
         class="stext-109 cl8 hov-cl1 trans-04">
        {{ sub.name }}
      </a>
      <span class="stext-109 cl4 m-l-6 m-r-6">/</span>
    {% endif %}

    <span class="stext-109 cl4">
      {{ currentProduct ? currentProduct.name : 'Produit' }}
    </span>
  </div>
</div>

{# =================== Product Detail =================== #}
<section class="sec-product-detail bg0 p-t-65 p-b-60">
  <div class="container">
    <div class="row">

      {# -------- Galerie (wrap-slick3) -------- #}
      <div class="col-md-6 col-lg-7 p-b-30">
        <div class="p-l-25 p-r-30 p-lr-0-lg">
          <div class="wrap-slick3 flex-sb flex-w">
            <div class="wrap-slick3-dots"></div>
            <div class="wrap-slick3-arrows flex-sb-m flex-w"></div>

            <div class="slick3 gallery-lb">
              {# 1) images attachées à la variante (tableau) #}
              {% if currentVariant and currentVariant.images is defined and currentVariant.images|length > 0 %}
                {% for img in currentVariant.images %}
                  {% set src = asset('uploads/productVariant/' ~ (img.imageName is defined ? img.imageName : img)) %}
                  <div class="item-slick3" data-thumb="{{ src }}">
                    <div class="wrap-pic-w pos-relative">
                      <img src="{{ src }}" alt="{{ currentProduct ? currentProduct.name : 'Image produit' }}">
                      <a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="{{ src }}">
                        <i class="fa fa-expand"></i>
                      </a>
                    </div>
                  </div>
                {% endfor %}
              {# 2) imageName seule sur la variante #}
              {% elseif currentVariant and currentVariant.imageName %}
                {% set src = asset('uploads/productVariant/' ~ currentVariant.imageName) %}
                <div class="item-slick3" data-thumb="{{ src }}">
                  <div class="wrap-pic-w pos-relative">
                    <img src="{{ src }}" alt="{{ currentProduct ? currentProduct.name : 'Image produit' }}">
                    <a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="{{ src }}">
                      <i class="fa fa-expand"></i>
                    </a>
                  </div>
                </div>
              {# 3) fallback placeholder #}
              {% else %}
                {% set src = asset('images/placeholder-image.png') %}
                <div class="item-slick3" data-thumb="{{ src }}">
                  <div class="wrap-pic-w pos-relative">
                    <img src="{{ src }}" alt="{{ currentProduct ? currentProduct.name : 'Image produit' }}">
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      {# -------- Détails ------ #}
      <div class="col-md-6 col-lg-5 p-b-30">
        <div class="p-r-50 p-t-5 p-lr-0-lg">
          <h4 class="mtext-105 cl2 js-name-detail p-b-14">
            {{ currentProduct ? currentProduct.name : 'Produit' }}
          </h4>

          <span class="mtext-106 cl2">
            {{ ((currentVariant.priceAmount ?? 0) / 100) | number_format(2, ',', ' ') }} €
          </span>

          {# compareAt (si présent) #}
          {% if currentVariant
                and currentVariant.compareAtAmount is defined
                and currentVariant.compareAtAmount
                and currentVariant.compareAtAmount > (currentVariant.priceAmount ?? 0)
          %}
            <span class="stext-105 cl3 p-l-10">
              <s>{{ (currentVariant.compareAtAmount / 100) | number_format(2, ',', ' ') }} €</s>
            </span>
          {% endif %}

          <p class="stext-102 cl3 p-t-23">
            {{ currentProduct and currentProduct.description ? currentProduct.description : '' }}
          </p>

          {# -------- Options + quantité + bouton -------- #}
          <div class="p-t-33">
            <div class="flex-w flex-r-m p-b-10">
              <div class="size-150 flex-w flex-m respon6-next">
                <div class="wrap-num-product flex-w m-r-20 m-tb-10">
                  <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
                    <i class="fs-16 zmdi zmdi-minus"></i>
                  </div>
                  <input class="mtext-104 cl3 txt-center num-product"
                         type="number"
                         name="num-product"
                         id="qty"
                         value="1"
                         min="1">
                  <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
                    <i class="fs-16 zmdi zmdi-plus"></i>
                  </div>
                </div>

                <button
                  type="button"
                  class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 js-addcart-detail"
                  data-variant-id="{{ currentVariant.id }}"
                  data-qty-el="#qty">
                  Ajouter au panier
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    {# -------- Description + infos + avis (sans onglets) -------- #}
    {% set descriptionFull = currentProduct and currentProduct.description ? currentProduct.description : '—' %}
    {% set descLimit = 220 %}
    {% set descriptionPreview = descriptionFull|length > descLimit
      ? descriptionFull|slice(0, descLimit) ~ '…'
      : descriptionFull
    %}

    <div class="bor10 m-t-50 p-t-30 p-b-40" style="overflow-x:hidden;">
      <div class="p-lr-15-md">
        <h5 class="mtext-108 cl2 p-b-12">Description</h5>

        <p class="stext-102 cl6 js-desc-preview">
          {{ descriptionPreview|nl2br }}
        </p>

        {% if descriptionFull|length > descLimit %}
          <p class="stext-102 cl6 js-desc-full dis-none m-t-10">
            {{ descriptionFull|nl2br }}
          </p>

          <button
            type="button"
            class="flex-c-m stext-101 cl2 size-104 bg0 bor1 hov-btn1 p-lr-15 trans-04 m-t-10 js-toggle-desc"
          >
            Voir plus
          </button>
        {% endif %}
      </div>

      {# ---------- Informations additionnelles (repliables) ---------- #}
      <div class="p-lr-15-md p-t-35">
        <button
          type="button"
          class="flex-w flex-sb-m w-full stext-106 cl2 p-tb-10 bor12 bg6 mg-collapse-toggle"
          data-target="#mg-extra-info"
        >
          <span>Informations additionnelles</span>
          <i class="zmdi zmdi-chevron-down"></i>
        </button>

        <div id="mg-extra-info" class="mg-collapse dis-none p-t-15">
          {% if currentProduct is defined and currentProduct.attributes is defined and currentProduct.attributes|length > 0 %}
            <ul class="p-lr-15-sm">
              {% for name, value in currentProduct.attributes %}
                <li class="p-b-10">
                  <p class="stext-102 cl3 m-b-2">{{ name|title }}</p>
                  <p class="stext-102 cl6">{{ value }}</p>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="stext-102 cl6 txt-center">
              Aucune information additionnelle disponible.
            </p>
          {% endif %}
        </div>
      </div>

      {# ---------- Avis (repliables) ---------- #}
      <div class="p-lr-15-md p-t-35">
        <button
          type="button"
          class="flex-w flex-sb-m w-full stext-106 cl2 p-tb-10 bor12 bg6 mg-collapse-toggle"
          data-target="#mg-reviews"
        >
          <span>
            Avis ({{ reviewsCount is defined ? reviewsCount : (reviews is defined ? reviews|length : 0) }})
          </span>
          <i class="zmdi zmdi-chevron-down"></i>
        </button>

        <div id="mg-reviews" class="mg-collapse dis-none p-t-15">
          <div class="p-b-30">
            {% if reviews is defined and reviews|length > 0 %}
              {% for r in reviews %}
                <div class="flex-w flex-t p-b-30">
                  <div class="wrap-pic-s size-109 bor0 of-hidden m-r-18 m-t-6">
                    <img
                      src="{{ r.avatarUrl is defined and r.avatarUrl ? r.avatarUrl : asset('images/avatar-01.jpg') }}"
                      alt="AVATAR">
                  </div>
                  <div class="size-207">
                    <div class="flex-w flex-sb-m p-b-17">
                      <span class="mtext-107 cl2 p-r-20">{{ r.userName }}</span>
                      {% set rating = r.rating is defined ? r.rating : 0 %}
                      <span class="fs-18 cl11">
                        {% for i in 1..(rating|round(0, 'floor')) %}
                          <i class="zmdi zmdi-star"></i>
                        {% endfor %}
                        {% for i in 1..(5 - (rating|round(0, 'floor'))) %}
                          <i class="zmdi zmdi-star-outline"></i>
                        {% endfor %}
                      </span>
                    </div>
                    <p class="stext-102 cl6">{{ r.content }}</p>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <p class="stext-102 cl6">Aucun avis pour l’instant.</p>
            {% endif %}

            <form class="w-full" method="post" action="#">
              <h5 class="mtext-108 cl2 p-b-7">Ajouter un avis</h5>
              <p class="stext-102 cl6">Votre email ne sera pas publié. Champs requis *</p>

              <div class="flex-w flex-m p-t-30 p-b-23">
                <span class="stext-102 cl3 m-r-16">Votre note</span>
                <span class="wrap-rating fs-18 cl11 pointer">
                  <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                  <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                  <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                  <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                  <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                  <input class="dis-none" type="number" name="rating">
                </span>
              </div>

              <div class="p-b-25">
                <div class="p-b-5">
                  <label class="stext-102 cl3" for="review">Votre avis</label>
                  <textarea class="size-110 bor8 stext-102 cl2 p-lr-20 p-tb-10"
                            id="review"
                            name="review"></textarea>
                </div>
                <div class="p-b-5">
                  <label class="stext-102 cl3" for="name">Nom *</label>
                  <input class="size-111 bor8 stext-102 cl2 p-lr-20"
                         id="name"
                         type="text"
                         name="name">
                </div>
                <div class="p-b-5">
                  <label class="stext-102 cl3" for="email">Email *</label>
                  <input class="size-111 bor8 stext-102 cl2 p-lr-20"
                         id="email"
                         type="email"
                         name="email">
                </div>
              </div>

              <button class="flex-c-m stext-101 cl0 size-112 bg7 bor11 hov-btn3 p-lr-15 trans-04 m-b-10">
                Envoyer
              </button>
            </form>

          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{# =================== Produits liés -> "Vous aimeriez aussi" =================== #}
<section class="sec-relate-product bg0 p-t-45 p-b-105">
  <div class="container">
    <div class="p-b-45">
      <h3 class="ltext-106 cl5 txt-center">Vous aimeriez aussi</h3>
    </div>

    {% if relatedProducts is defined and relatedProducts|length > 0 %}
      <div class="wrap-slick2">
        <div class="slick2">
          {% for rp in relatedProducts %}
            <div class="item-slick2 p-l-15 p-r-15 p-t-15 p-b-15">
              <div class="block2">
                <div class="block2-pic hov-img0">
                  <img src="{{ rp.imageUrl is defined ? rp.imageUrl : asset('images/placeholder-image.png') }}"
                       alt="{{ rp.name }}">

                  <a href="{{ path('product_show', {
                        productSlug: rp.productSlug,
                        variantSlug: rp.variantSlug
                      }) }}"
                     class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                    Voir
                  </a>
                </div>
                <div class="block2-txt flex-w flex-t p-t-14">
                  <div class="block2-txt-child1 flex-col-l">
                    <a href="{{ path('product_show', {
                          productSlug: rp.productSlug,
                          variantSlug: rp.variantSlug
                        }) }}"
                       class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                      {{ rp.name }}
                    </a>
                    <span class="stext-105 cl3">
                      {{ ((rp.priceAmount ?? 0) / 100) | number_format(2, ',', ' ') }} €
                    </span>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{# =================== Sticky "Ajouter au panier" mobile =================== #}
<div
  class="mg-sticky-addcart d-block d-md-none"
  style="
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background: #fff;
    box-shadow: 0 -4px 10px rgba(0,0,0,0.08);
  "
>
  <div class="container">
    <div class="flex-w flex-sb-m p-tb-10">
      <div>
        <span class="stext-110 cl2">Total</span><br>
        <span class="mtext-106 cl2">
          {{ ((currentVariant.priceAmount ?? 0) / 100) | number_format(2, ',', ' ') }} €
        </span>
      </div>

      <div class="flex-w flex-m">
        <div class="wrap-num-product flex-w m-r-10">
          <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m js-sticky-qty-down">
            <i class="fs-16 zmdi zmdi-minus"></i>
          </div>
          <input class="mtext-104 cl3 txt-center num-product js-sticky-qty" type="number" value="1" min="1">
          <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m js-sticky-qty-up">
            <i class="fs-16 zmdi zmdi-plus"></i>
          </div>
        </div>

        <button
          type="button"
          class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-20 trans-04 js-addcart-detail js-sticky-addcart"
          data-variant-id="{{ currentVariant.id }}"
        >
          Ajouter au panier
        </button>
      </div>
    </div>
  </div>
</div>

{# =================== JS local =================== #}
<script>
  (function () {
    // --- Voir plus / Voir moins description ---
    var preview = document.querySelector('.js-desc-preview');
    var full = document.querySelector('.js-desc-full');
    var btnDesc = document.querySelector('.js-toggle-desc');

    if (btnDesc && full && preview) {
      var expanded = false;

      btnDesc.addEventListener('click', function () {
        expanded = !expanded;

        if (expanded) {
          full.classList.remove('dis-none');
          preview.classList.add('dis-none');
          btnDesc.textContent = 'Voir moins';
        } else {
          full.classList.add('dis-none');
          preview.classList.remove('dis-none');
          btnDesc.textContent = 'Voir plus';
        }
      });
    }

    // --- Collapses Infos + Avis ---
    document.querySelectorAll('.mg-collapse-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetSelector = btn.getAttribute('data-target');
        if (!targetSelector) return;

        var target = document.querySelector(targetSelector);
        if (!target) return;

        var isHidden = target.classList.contains('dis-none');
        var icon = btn.querySelector('i.zmdi');

        if (isHidden) {
          target.classList.remove('dis-none');
          if (icon) {
            icon.classList.remove('zmdi-chevron-down');
            icon.classList.add('zmdi-chevron-up');
          }
        } else {
          target.classList.add('dis-none');
          if (icon) {
            icon.classList.remove('zmdi-chevron-up');
            icon.classList.add('zmdi-chevron-down');
          }
        }
      });
    });

    // --- Synchronisation barre sticky / bloc principal ---
    var mainQty = document.getElementById('qty');
    var stickyQty = document.querySelector('.js-sticky-qty');
    var stickyDown = document.querySelector('.js-sticky-qty-down');
    var stickyUp = document.querySelector('.js-sticky-qty-up');

    if (mainQty && stickyQty) {
      stickyQty.value = mainQty.value;

      mainQty.addEventListener('input', function () {
        stickyQty.value = mainQty.value;
      });

      stickyQty.addEventListener('input', function () {
        var val = parseInt(stickyQty.value, 10);
        if (isNaN(val) || val < 1) {
          val = 1;
          stickyQty.value = 1;
        }
        mainQty.value = val;
      });
    }

    if (stickyDown && stickyQty && mainQty) {
      stickyDown.addEventListener('click', function () {
        var val = parseInt(stickyQty.value, 10) || 1;
        val = Math.max(1, val - 1);
        stickyQty.value = val;
        mainQty.value = val;
      });
    }

    if (stickyUp && stickyQty && mainQty) {
      stickyUp.addEventListener('click', function () {
        var val = parseInt(stickyQty.value, 10) || 1;
        val = val + 1;
        stickyQty.value = val;
        mainQty.value = val;
      });
    }
  })();
</script>

{% endblock %}

