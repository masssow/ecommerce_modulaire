{# templates/reset_password/email.html.twig #}
{% extends 'emails/_base.html.twig' %}

{# Optionnel : tu peux garder ce block si tu l'utilises #}
{% block subject %}Réinitialisation de mot de passe — Lacrose{% endblock %}

{% block body %}
  <p style="margin:0 0 12px 0;">
    Bonjour,
  </p>

  <p style="margin:0 0 12px 0;">
    Vous avez demandé à réinitialiser votre mot de passe sur <strong>Lacrose</strong>.
    Cliquez sur le bouton ci-dessous :
  </p>

  {% set resetUrl = url('app_reset_password', { token: resetToken.token }) %}

  <p style="margin:18px 0;">
    <a href="{{ resetUrl }}"
       style="display:inline-block;padding:12px 16px;background:#111;color:#fff;text-decoration:none;border-radius:8px;font-size:14px;">
      Réinitialiser mon mot de passe
    </a>
  </p>

  <p style="margin:0 0 12px 0;font-size:13px;color:#555;">
    Ce lien expirera : {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
  </p>

  <p style="margin:18px 0 0 0;font-size:13px;color:#555;">
    Si le bouton ne fonctionne pas, copiez-collez ce lien :
    <br>
    <a href="{{ resetUrl }}">{{ resetUrl }}</a>
  </p>

  <hr style="border:none;border-top:1px solid #eee;margin:20px 0;">

  <p style="margin:0;font-size:12px;color:#777;">
    Si vous n’êtes pas à l’origine de cette demande, ignorez simplement cet email.
  </p>
{% endblock %}
