{% extends 'base.html.twig' %}
{% block title %}Modifier le moyen de paiement{% endblock %}

{% block body %}
<div class="container">
  <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
    <a href="{{ path('app_home') }}" class="stext-109 cl8 hov-cl1 trans-04">Accueil
      <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
    </a>
    <a href="{{ path('account_profile') }}#payments" class="stext-109 cl8 hov-cl1 trans-04">Mon compte
      <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
    </a>
    <span class="stext-109 cl4">Modifier le moyen de paiement</span>
  </div>
</div>

<section class="bg0 p-t-52 p-b-60">
  <div class="container">
    <h4 class="mtext-112 cl2 p-b-20">Modifier le moyen de paiement</h4>
    <div class="row">
      <div class="col-lg-8">
        {% include 'payment/_form.html.twig' with {
          form: form,
          submit_label: 'Mettre à jour',
          cancel_path: path('account_profile')
        } %}
      </div>
    </div>
  </div>
</section>
{% endblock %}
