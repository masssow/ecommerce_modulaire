{% extends 'base.html.twig' %}

{% block title %}Politique des retours et remboursements - Keur Paris{% endblock %}

{% block body %}
<!-- Title page -->
<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('images/bg-01.jpg');">
	<h2 class="ltext-105 cl0 txt-center">
		Retours & Remboursements
	</h2>
</section>

<section class="bg0 p-t-75 p-b-120">
	<div class="container">
		<div class="row">
			<div class="col-md-12 col-lg-10 m-lr-auto">
				<div class="p-t-7">

					<h3 class="mtext-111 cl2 p-b-16">Délai de retour</h3>
					<p class="stext-113 cl6 p-b-26">
						Vous disposez d’un délai de 14 jours après réception de votre commande
						pour demander un retour, conformément à la réglementation européenne.
					</p>

					<h3 class="mtext-111 cl2 p-b-16">Conditions</h3>
					<p class="stext-113 cl6 p-b-26">
						Les articles doivent être retournés en parfait état, non portés,
						non utilisés et dans leur emballage d’origine.
						Les produits personnalisés ou sur-mesure ne sont pas éligibles au retour.
					</p>

					<h3 class="mtext-111 cl2 p-b-16">Remboursements</h3>
					<p class="stext-113 cl6 p-b-26">
						Après réception et vérification du produit retourné,
						le remboursement est effectué sur le moyen de paiement initial.
					</p>

				</div>
			</div>
		</div>
	</div>
</section>

{% endblock %}
