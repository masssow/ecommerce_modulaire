{# templates/product/partials/_grid_product.html.twig #}

<div class="row isotope-grid">
  {% set favIds = favoritesIds|default([]) %}

  {% for variant in productVariants %}
    {% set product = variant.product %}
    {% if product %}

      {% set vImg = asset(
        variant.imageName
          ? 'uploads/productVariant/' ~ variant.imageName
          : 'images/placeholder-image.png'
      ) %}

      <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item cat-{{ product.subCategory.id }}">
        <div class="block2">

          <div class="block2-pic hov-img0">
            <img src="{{ vImg }}" alt="{{ product.name }}" loading="lazy">

            <a
              href="{{ path('product_show', {
                productSlug: product.slug,
                variantSlug: variant.slug ?? variant.id
              }) }}"
              class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04"
            >
              Voir le produit
            </a>
          </div>

          <div class="block2-txt flex-w flex-t p-t-14">
            <div class="block2-txt-child1 flex-col-l">
              
              <a
                href="{{ path('product_show', {
                  productSlug: product.slug,
                  variantSlug: variant.slug ?? variant.id
                }) }}"
                class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6"
              >
                {{ product.name }}{% if variant.name %} – {{ variant.name }}{% endif %}
              </a>

              <span class="stext-105 cl3">
                {{ (variant.priceAmount|default(0) / 100)|number_format(2, '.', ' ') }} €
              </span>

            </div>
          </div>

        </div>
      </div>

    {% endif %}
  {% else %}
    <div class="col-12 p-b-35">
      <p class="stext-111 cl6">Aucun produit trouvé pour ces critères.</p>
    </div>
  {% endfor %}
</div>
