{# Boutons de filtre Isotope #}

{# Toujours afficher "Tous" #}
<button
  class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 how-active1"
  data-filter="*"
>
  Tous
</button>

{# Sous-catégories (si disponibles) #}
{% for sub in (subCategories|default([])) %}
  <button
    class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5"
    data-filter=".cat-{{ sub.id }}"
  >
    {{ sub.name }}
  </button>
{% endfor %}
