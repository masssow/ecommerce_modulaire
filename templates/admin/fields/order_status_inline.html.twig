{# Rendu dans la liste EasyAdmin : un select + bouton Valider #}
{% set current = field.value %}
{% set labels = order_status_choices() %} {# value => label #}

<form
  action="{{ path('admin_order_update_status', {id: entity.primaryKeyValue}) }}"
  method="post"
  class="d-flex align-items-center gap-2"
  style="min-width: 220px"
>
  <input type="hidden" name="_token" value="{{ csrf_token('order_status' ~ entity.primaryKeyValue) }}">
  onchange="this.form.submit()"
  {# <select name="status" class="form-select form-select-sm">
    {% for value, label in labels %}
      <option value="{{ value }}" {{ value == current ? 'selected' : '' }}>
        {{ label }}
      </option>
    {% endfor %}
  </select> #}
  <button type="submit" class="btn btn-sm btn-primary">Valider</button>
</form>
